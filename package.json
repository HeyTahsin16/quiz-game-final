{
	"name": "quiz-duel",
	"version": "0.25.0",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 3000",
		"check": "biome check --fix",
		"typecheck": "tsc --noEmit",
		"test": "ava",
		"test:watch": "ava --watch",
		"test:coverage": "c8 ava",
		"sim": "tsx src/engine/sim.ts",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0 --port 3000"
	},
	"ava": {
		"files": [
			"tests/**/*.test.ts"
		],
		"extensions": {
			"ts": "module"
		},
		"nodeArguments": [
			"--import=tsx"
		],
		"workerThreads": false
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"ava": "^6.4.1",
		"c8": "^10.1.3",
		"globals": "^17.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@types/katex": "^0.16.8",
		"firebase": "^13.1.0",
		"immer": "^10.1.3",
		"katex": "^0.19.1",
		"lucide-react": "^1.61.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	}
}
